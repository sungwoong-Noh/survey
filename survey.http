### POST
POST http://localhost:8081/v1/api/survey
Content-Type: application/json

{
  "title": "햄버거 선호도 조사",
  "description": "햄부기부기",
  "questionCreateRequestList": [
    {
      "questionType": "SINGLE_CHOICE",
      "questionText": "햄버거를 주에 몇 회 드시나요",
      "isRequired": false,
      "choiceCreateRequestList": [
        {
          "value": "1회"
        },
        {
          "value": "2회"
        },
        {
          "value": "3회"
        }
      ],
      "description": "이건 질문에 설명입니다."
    },
    {
      "questionType": "LONG_TEXT",
      "questionText": "What can we do to improve our service?",
        "isRequired": true
    }
  ]
}

### GET
GET http://localhost:8081/v1/api/survey?keyword=t&page=0&size=10
Content-Type: application/json